<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#1478C8</item>
        <item name="android:windowBackground">#F3FAFC</item>
        <item name="android:colorControlNormal">#536879</item>
        <item name="android:colorControlActivated">#1478C8</item>
        <item name="android:navigationBarColor">#FFFFFF</item>
